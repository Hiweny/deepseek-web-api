<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DeepSeekWebAPI</AssemblyName>
    <RootNamespace>DSWebApi.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.8</Version>
    <FileVersion>1.0.8.0</FileVersion>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <Product>DeepSeek Web API</Product>
    <AssemblyTitle>DeepSeek Web API (Windows)</AssemblyTitle>
    <Company>Hiweny</Company>
    <Description>把 chat.deepseek.com 官网封装成本机/局域网 OpenAI 兼容接口</Description>
    <!-- 允许在非 Windows 主机上编译（CI/沙箱自检用） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <!-- 单文件自包含发布 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- 必须显式指定 LogicalName：默认逻辑名是 RootNamespace+目录(DSWebApi.Desktop.Assets.bridge.js)，
         一旦 AssemblyName/RootNamespace 变化就会读不到，曾导致 bridge.js 0 字节、API 全部 NO_BRIDGE。 -->
    <EmbeddedResource Include="Assets\bridge.js" LogicalName="bridge.js" />
    <EmbeddedResource Include="Assets\e2e-login.js" LogicalName="e2e-login.js" />
    <None Include="Assets\bridge.js" CopyToOutputDirectory="PreserveNewest" Link="Assets\bridge.js" />
  </ItemGroup>

</Project>
